OPENWEATHER_API_KEY=
DEFAULT_TEMPERATURE_C=26.5
DEFAULT_HUMIDITY_PCT=72.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:8000

# ── Voice agent ──────────────────────────────────────────────────────────
# Defaults run fully offline with no account or key. Nothing below is
# required; set values only to move off the offline stack.
#   ASR: vosk (offline, default) | browser | bhashini
#   TTS: piper (offline, default) | browser | bhashini
VOICE_ASR_PROVIDER=vosk
VOICE_TTS_PROVIDER=piper

# Only needed if you switch a provider above to 'bhashini'.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
